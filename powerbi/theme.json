{
  "name": "Olist CX Storyteller",
  "dataColors": ["#0B6E7A", "#E4572E", "#7FB7BE", "#F2B134", "#5C6B70", "#2F6B78", "#C9B79C", "#9FC3C9"],
  "background": "#FFFFFF",
  "foreground": "#1F2A2E",
  "tableAccent": "#0B6E7A",
  "good": "#0B6E7A",
  "neutral": "#C9B79C",
  "bad": "#E4572E",
  "maximum": "#0B3C49",
  "center": "#7FB7BE",
  "minimum": "#E9F2F3",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A2E" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A2E" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5C6B70" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#0B3C49" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FAF8F4" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#FAF8F4" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E9E2D6" } }, "radius": 8 }],
        "title": [{ "fontColor": { "solid": { "color": "#1F2A2E" } }, "fontSize": 12 }]
      }
    }
  }
}
